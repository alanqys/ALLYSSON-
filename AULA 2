const alunos = [
  {
    nome: "Alan",
    idade: 22,
    curso: "ADS",
    notas: [7.0, 8.0, 10.0]
  },
  {
    nome: "Marcelo",
    idade: 20,
    curso: "Engenharia",
    notas: [6.0, 8.2, 9.0]
  },
  {
    nome: "Maria",
    idade: 23,
    curso: "ADS",
    notas: [7.0, 8.5, 7.0]
  }
];

const calcularMedia = (notas) => {
  const soma = notas.reduce((acc, nota) => acc + nota, 0);
  return soma / notas.length;
};

const nomesADS = alunos
  .filter(aluno => aluno.curso === "ADS")
  .map(aluno => aluno.nome);

console.log(nomesADS);

const mediasADS = alunos
  .filter(aluno => aluno.curso === "ADS")
  .map(aluno => ({
    nome: aluno.nome,
    media: Number(calcularMedia(aluno.notas).toFixed(2))
  }));

console.log(mediasADS);

const melhorAluno = alunos.reduce((melhor, atual) => {
  const mediaAtual = calcularMedia(atual.notas);
  const mediaMelhor = calcularMedia(melhor.notas);
  return mediaAtual > mediaMelhor ? atual : melhor;
});

console.log(melhorAluno.nome);

const alunosADS = alunos.filter(aluno => aluno.curso === "ADS");

const melhorADS = alunosADS.reduce((melhor, atual) => {
  return calcularMedia(atual.notas) > calcularMedia(melhor.notas) ? atual : melhor;
});

console.log(melhorADS.nome);

const maisJovemEng = alunos
  .filter(aluno => aluno.curso === "Engenharia")
  .reduce((maisJovem, atual) => {
    return atual.idade < maisJovem.idade ? atual : maisJovem;
  });

console.log(maisJovemEng.nome);

const totalMediasADS = alunosADS.reduce((acc, aluno) => {
  return acc + calcularMedia(aluno.notas);
}, 0);

const mediaGeralADS = totalMediasADS / alunosADS.length;

console.log(Number(mediaGeralADS.toFixed(2)));

const statusAlunos = alunos.map(aluno => {
  const media = calcularMedia(aluno.notas);
  let status = "REPROVADO";

  if (media >= 7) {
    status = "APROVADO";
  } else if (media >= 5) {
    status = "FINAL";
  }

  return {
    nome: aluno.nome,
    media: Number(media.toFixed(2)),
    status: status
  };
});

console.log(statusAlunos);
