    if (p.preco >= 10000) {
        console.log(p)
    }
})

const produtosFiltrados = produtos.filter(p => p.preco >= 10000)

console.log(produtosFiltrados)

// Soma dos números

const soma = numeros.reduce((ac, at) => {
    return ac + at
}, 0)

// Maior número

const maior = numeros.reduce((ac, at) => {
    if (at > ac) {
        return at
    } else {
        return ac
    }
}, numeros[0])

// Menor número

const menor = numeros.reduce((ac, at) => {
    if (at < ac) {
        return at
    } else {
        return ac
    }
}, numeros[0])

// Produto mais caro

const produtocaro = produtos.reduce((ac, at) => {
    if (at.preco > ac.preco) {
        return at
    } else {
        return ac
    }
})

// Produto mais barato da categoria Jogos

const games = produtos.filter(p => p.categoria === "Jogos")

const gamesmaisbarato = games.reduce((ac, at) => {
    if (at.preco < ac.preco) {
        return at
    } else {
        return ac
    }
})

console.log("Soma: ", soma)
console.log("Maior: ", maior)
console.log("Menor: ", menor)
console.log("Mais caro: ", produtocaro.nome)
console.log("Mais barato de Jogos: ", gamesmaisbarato.nome)
