const produtos = [
    {
        nome: "PS6",
        preco: 10000,
        categoria: "Console"
    },
    {
        nome: "Iphone 17",
        preco: 15000,
        categoria: "Celular"
    },
    {
        nome: "RDR3",
        preco: 600,
        categoria: "Jogos"
    },
    {
        nome: "Bully",
        preco: 700,
        categoria: "Jogos"
    }

]

const numeros = [1, 24, 38, 75]

const imprimir = function(x) {
    console.log(x)
}

const multiplicados = numeros.map(n => n * 2)

console.log("Números: ", numeros)
console.log("Multiplicados: ", multiplicados)

const even = numeros.filter(n => n % 2 === 0)

console.log("Pares: ", even)
console.log("Ímpares: ", numeros.filter(n => n % 2 !== 0))

// ----------------------- //

console.log("------ PRODUTOS -----")

produtos.forEach(p => console.log(p))

const produtosCategorias = produtos.map(
    p => `${p.nome} (${p.categoria})`
)

produtosCategorias.forEach(p => console.log(p))

// Produtos da Categoria Jogos

console.log("Jogos")

const jogos = produtos.filter(p => p.categoria === "Jogos")

jogos.forEach(p => console.log(p))

// Produtos com preço maior ou igual a 10000

console.log("Produtos com preço >= 10000:")

